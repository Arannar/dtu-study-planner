<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin the console runner's WCF transitive dependency; ASP.NET supplies this in the web host. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <ProjectReference Include="..\backend\backend.csproj" />
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <Content Remove="artifacts\**\*" />
    <None Remove="artifacts\**\*" />
  </ItemGroup>
</Project>
